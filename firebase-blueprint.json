{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account and profile document in Firestore",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Unique user ID matching authentication UID"
        },
        "name": {
          "type": "string",
          "description": "Display name of the user",
          "maxLength": 100
        },
        "phone": {
          "type": "string",
          "description": "User mobile phone number",
          "maxLength": 20
        },
        "role": {
          "type": "string",
          "description": "Role within Unmoor Club (user, admin, system)",
          "enum": ["user", "admin", "system"]
        },
        "coins": {
          "type": "number",
          "description": "Current club coin balance"
        },
        "status": {
          "type": "string",
          "description": "Account approval status",
          "enum": ["active", "pending", "banned"]
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp when the profile was created"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp when the profile was last updated"
        }
      },
      "required": ["userId", "name", "role", "coins", "status", "createdAt"]
    },
    "PaymentDeposit": {
      "title": "PaymentDeposit",
      "description": "Payment or deposit request submitted by a user",
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "description": "Unique transaction ID"
        },
        "userId": {
          "type": "string",
          "description": "ID of user who submitted payment"
        },
        "amount": {
          "type": "number",
          "description": "Deposit amount in BDT or Coins"
        },
        "method": {
          "type": "string",
          "description": "Payment method (bkash, nagad, rocket, coupon, manual)",
          "maxLength": 50
        },
        "type": {
          "type": "string",
          "description": "Payment category (deposit, apply, premium, coupon)",
          "enum": ["deposit", "apply", "premium", "coupon", "purchase"]
        },
        "status": {
          "type": "string",
          "description": "Processing status",
          "enum": ["pending", "approved", "rejected"]
        },
        "createdAt": {
          "type": "string",
          "description": "Submission timestamp"
        }
      },
      "required": ["paymentId", "userId", "amount", "type", "status", "createdAt"]
    },
    "CoinHistory": {
      "title": "CoinHistory",
      "description": "Ledger entry for coin credits, debits, or transfers",
      "type": "object",
      "properties": {
        "historyId": {
          "type": "string",
          "description": "Unique ledger entry ID"
        },
        "userId": {
          "type": "string",
          "description": "User account credited or debited"
        },
        "amount": {
          "type": "number",
          "description": "Coin delta amount"
        },
        "type": {
          "type": "string",
          "description": "Transaction type category",
          "maxLength": 64
        },
        "source": {
          "type": "string",
          "description": "Source origin of transaction",
          "maxLength": 191
        },
        "reference": {
          "type": "string",
          "description": "Human-readable description or order reference",
          "maxLength": 255
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of ledger record"
        }
      },
      "required": ["historyId", "userId", "amount", "type", "createdAt"]
    },
    "HeadtailBet": {
      "title": "HeadtailBet",
      "description": "Game wager record for Head & Tail",
      "type": "object",
      "properties": {
        "betId": {
          "type": "string",
          "description": "Unique bet ID"
        },
        "userId": {
          "type": "string",
          "description": "User who placed the bet"
        },
        "choice": {
          "type": "string",
          "description": "User side choice",
          "enum": ["head", "tail"]
        },
        "result": {
          "type": "string",
          "description": "Flipped coin outcome",
          "enum": ["head", "tail"]
        },
        "betAmount": {
          "type": "number",
          "description": "Amount wagered in coins"
        },
        "profit": {
          "type": "number",
          "description": "Net coin payout or loss"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of the bet"
        }
      },
      "required": ["betId", "userId", "choice", "result", "betAmount", "profit", "createdAt"]
    },
    "SystemLedger": {
      "title": "SystemLedger",
      "description": "Master audit trail for club treasury reserve",
      "type": "object",
      "properties": {
        "ledgerId": {
          "type": "string",
          "description": "Unique audit log ID"
        },
        "type": {
          "type": "string",
          "description": "Transaction category (coin_cut, donation, game_win, store, admin)"
        },
        "amount": {
          "type": "number",
          "description": "Amount credited or debited to treasury"
        },
        "source": {
          "type": "string",
          "description": "Source module or initiating action"
        },
        "reference": {
          "type": "string",
          "description": "Reference details"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of entry"
        }
      },
      "required": ["ledgerId", "type", "amount", "createdAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Support or direct message document",
      "type": "object",
      "properties": {
        "messageId": {
          "type": "string",
          "description": "Unique message ID"
        },
        "senderId": {
          "type": "string",
          "description": "Sender user ID"
        },
        "receiverId": {
          "type": "string",
          "description": "Recipient user ID"
        },
        "message": {
          "type": "string",
          "description": "Text message content"
        },
        "seen": {
          "type": "boolean",
          "description": "Whether message has been seen by recipient"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp of message"
        }
      },
      "required": ["messageId", "senderId", "receiverId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile collection"
    },
    "/payments/{paymentId}": {
      "schema": "PaymentDeposit",
      "description": "User deposit and application payment collection"
    },
    "/coin_history/{historyId}": {
      "schema": "CoinHistory",
      "description": "Coin transaction history ledger"
    },
    "/headtail_bets/{betId}": {
      "schema": "HeadtailBet",
      "description": "Game wager bets collection"
    },
    "/system_ledger/{ledgerId}": {
      "schema": "SystemLedger",
      "description": "Club treasury audit ledger"
    },
    "/chat_messages/{messageId}": {
      "schema": "ChatMessage",
      "description": "Direct and support chat messages"
    }
  }
}
